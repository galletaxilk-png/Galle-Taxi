# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION:
# Required for real Firebase Authentication and Cloud Firestore for project: galle-taxi
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_PROJECT_ID="galle-taxi"
VITE_FIREBASE_AUTH_DOMAIN="galle-taxi.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="galle-taxi.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef12345678"

# RESEND EMAIL API CONFIGURATION:
# Get free API key from https://resend.com (free 3,000 emails/month)
RESEND_API_KEY="re_your_resend_api_key_here"
# Verified custom domain sender:
RESEND_FROM_EMAIL="Galle Taxi <support@galletaxi.lk>"
# Dispatcher email that receives CC copies of every booking:
DISPATCHER_EMAIL="galletaxi.lk@gmail.com"
SUPPORT_EMAIL="support@galletaxi.lk"

# GOOGLE MAPS PLATFORM CONFIGURATION:
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKey"
